  flex-direction: column;
  gap: 8px;
  transition: border-color 0.3s, box-shadow 0.3s;
}
.pricing-card:hover {
  border-color: rgba(16, 97, 249, 0.48);
  box-shadow:
    inset 1px 1px 20px 2px rgba(16, 97, 249, 0.16),
    0 0 28px rgba(16, 97, 249, 0.14);
}
.pricing-icon {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background: linear-gradient(135deg, #e8f0fe, #fff);
  display: grid;
  place-items: center;
  color: #1e3a8a;
  font-size: 22px;
  margin: 0 auto 16px;
}
.plan-name {
  text-align: center;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 8px;
}
.plan-price {
  text-align: center;
  font-size: 34px;
  font-weight: 700;
  line-height: 1.1;
  display: block;
  margin-bottom: 8px;
}
.plan-price .per {
  font-size: 18px;
  font-weight: 500;
  color: #fff;
}
.plan-note {
  text-align: center;
  color: #fff;
  font-size: 16px;
  margin-bottom: 24px;
}
.plan-features {
  width: 100%;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
  margin-bottom: 24px;
}
.plan-features li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: #fff;
  font-size: 16px;
  line-height: 1.45;
}
.check-icon {
  color: rgba(255, 255, 255, 0.78);
  font-size: 18px;
  flex-shrink: 0;
  margin-top: 3px;
}
.pricing-cta-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  padding: 12px 16px;
  border: 1px solid transparent;
  border-radius: var(--btn-radius);
  background: var(--grad);
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(16, 97, 249, 0.36);
  transition: var(--btn-transition);
}
.pricing-cta-btn:hover {
  background: transparent;
  color: var(--accent);
  border-color: var(--accent-hover);
  box-shadow: var(--btn-shadow-hover);
}
.pricing-cta-btn:hover .pricing-arrow-badge {
  background: var(--accent-hover);
}
.pricing-cta-btn:hover .pricing-arrow-badge img {
  filter: brightness(0) invert(1);
}
.pricing-arrow-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 14px;
  background: #fff;
  flex-shrink: 0;
  overflow: hidden;
  transition: background 0.25s;
}
.pricing-arrow-badge img {
  width: 55%;
  height: 55%;
  object-fit: contain;
}

/* ========================
   CONTACT
   ======================== */
.contact-section {
  max-width: var(--section-max-w);
  width: 100%;
  padding: var(--section-pad);
  background: var(--bg);
  margin: 0 auto;
}
.contact-content-parent {
  max-width: 800px;
  width: 100%;
  padding: 40px;
  border: 1px solid #f5f5f533;
  margin: 0 auto;
}
.contact-heading {
  text-align: center;
  margin-bottom: 40px;
}
.contact-heading h2 {
  font-size: 42px;
  font-weight: 700;
  line-height: 1.1;
}
.contact-form {
  max-width: 720px;
  margin: 0 auto;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 16px;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.form-group.full {
  grid-column: 1 / -1;
}
.form-label {
  font-size: 14px;
  font-weight: 500;
  color: #f8fafc;
}
.form-label .req {
  color: #f87171;
  margin-left: 4px;
}
.form-input,
.form-textarea {
  width: 100%;
  padding: 12px 14px;
  background: rgba(2, 6, 24, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.22);
  color: var(--text);
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.4;
  border-radius: 0;
  outline: none;
  transition: border-color 0.25s, box-shadow 0.25s;
}
.form-input::placeholder,
.form-textarea::placeholder {
  color: rgba(255, 255, 255, 0.34);
}
.form-input:focus,
.form-textarea:focus {
  border-color: rgba(16, 97, 249, 0.55);
  box-shadow: 0 0 0 3px rgba(16, 97, 249, 0.12);
}
.form-textarea {
  resize: vertical;
  min-height: 140px;
}
.form-submit {
  display: flex;
  justify-content: center;
}
.btn-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  padding: 12px 16px;
  border: 1px solid transparent;
  border-radius: var(--btn-radius);
  background: var(--grad);
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  box-shadow: var(--btn-shadow);
  transition: var(--btn-transition);
}
.btn-submit:hover {
  background: transparent;
  color: var(--accent);
  border-color: var(--accent-hover);
  box-shadow: var(--btn-shadow-hover);
}
.btn-submit:hover .arrow-circle {
  background: var(--accent-hover);
}
.btn-submit:hover .arrow-circle img {
  filter: brightness(0) invert(1);
}
.success-message {
  text-align: center;
  padding: 40px 20px;
}
.success-icon {
  font-size: 48px;
  color: var(--accent);
  margin-bottom: 16px;
}
.success-message h3 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
}
.success-message p {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 24px;
}

