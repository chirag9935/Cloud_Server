}
.testimonials-kicker-text::before,
.testimonials-kicker-text::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 100px;
  height: 1.5px;
  background: linear-gradient(90deg, rgba(16, 97, 249, 0.5), rgba(16, 97, 249, 0));
}
.testimonials-kicker-text::before {
  right: calc(100% - 16px);
  transform: translateY(-50%) scaleX(-1);
}
.testimonials-kicker-text::after {
  left: calc(100% - 16px);
  transform: translateY(-50%);
}
.testimonials-heading h2 {
  font-size: 34px;
  font-weight: 700;
  line-height: 1.1;
}
.testimonials-heading h2 span {
  color: var(--accent);
}
.testimonials-track-wrapper {
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  cursor: grab;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.testimonials-track-wrapper::-webkit-scrollbar {
  display: none;
}
.testimonials-track-wrapper:active {
  cursor: grabbing;
}
.testimonials-track {
  display: flex;
  gap: 24px;
  width: max-content;
  align-items: flex-start;
}
.testimonial-card {
  flex-shrink: 0;
  width: 240px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  background: var(--bg);
  border: 1px solid var(--border-blue);
