}
.testimonial-quote {
  color: #fff;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.55;
}
.testimonial-rating {
  display: flex;
  gap: 6px;
}
.star {
  font-size: 20px;
  line-height: 1;
}
.star-filled {
  color: #ffa43c;
}
.star-empty {
  color: #ffa43c;
  opacity: 0.3;
}
.testimonial-person {
  display: flex;
  align-items: center;
  gap: 16px;
}
.testimonial-avatar {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border: 1px solid rgba(255, 255, 255, 0.08);
