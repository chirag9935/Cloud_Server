}

/* ========================
   PRICING
   ======================== */
.pricing-section {
  max-width: var(--section-max-w);
  width: 100%;
  margin: 0 auto;
  padding: var(--section-pad);
}
.pricing-kicker {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.pricing-kicker-text {
  color: var(--accent);
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
}
.pricing-kicker-line {
  height: 1.5px;
  flex: 1;
  max-width: 260px;
  background: linear-gradient(90deg, rgba(16, 97, 249, 0.5), rgba(16, 97, 249, 0));
  border-radius: 2px;
}
.pricing-heading {
  font-size: 34px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 40px;
  width: 100%;
  max-width: 1076px;
}
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 1200px;
  width: 100%;
}
.pricing-card {
  width: 100%;
  background: var(--bg);
  border: 1px solid #f5f5f533;
  padding: 32px;
