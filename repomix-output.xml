  max-width: var(--section-max-w);
  margin: 0 auto;
}
.testimonials-heading {
  text-align: center;
  margin-bottom: 40px;
}
.testimonials-kicker {
  display: inline-flex;
  align-items: center;
  margin-bottom: 16px;
}
.testimonials-kicker-text {
  color: var(--accent);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0 16px;
