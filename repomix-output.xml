/* ========================
   SCROLL-TO-TOP FAB
   ======================== */
.restart-fab {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 220;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px 8px 10px;
  border: 0;
  border-radius: 9999px;
  background: #2a2a2a;
  color: #fff;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.28);
  cursor: pointer;
  font-family: var(--font);
  transition: background 0.18s, transform 0.3s ease, opacity 0.3s ease;
  opacity: 1;
}
.restart-fab:hover {
  background: #3a3a3a;
  transform: translateY(-1px);
}
.restart-fab--hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.restart-fab-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 12px;
}
.restart-fab-text {
  display: flex;
  align-items: center;
  gap: 12px;
}
.restart-fab-text-main {
  font-size: 14px;
  font-weight: 600;
}
.restart-fab-text-key {
  font-size: 12px;
  color: #888;
  font-weight: 500;
}

/* ========================
   RESPONSIVE
   ======================== */

/* Large desktops — reduce outer padding */
@media (max-width: 1440px) {
  .hero,
  .services-section,
  .about-section,
  .pricing-section,
  .testimonials-section,
  .contact-section,
  .site-footer {
    padding-left: 80px;
    padding-right: 80px;
  }
}

/* Medium desktops / large tablets */
@media (max-width: 1200px) {
  .hero,
  .services-section,
  .about-section,
  .pricing-section,
  .testimonials-section,
  .contact-section,
  .site-footer {
    padding-left: 48px;
    padding-right: 48px;
  }
}

/* Tablets */
@media (max-width: 992px) {
  .navbar {
    padding: 20px 32px;
  }
  .nav-links {
    display: none;
